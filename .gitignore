*.pkl
*.npy
*.faiss
*.bin
*.pt
*.cbm

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Large data directories (regenerate with scripts)
data/conformers/
data/rag_features/
data/rag_features_unimol/

# Jupyter checkpoints
.ipynb_checkpoints/

# Logs (can regenerate)
bash/*/logs/
logs/

# CatBoost artifacts
catboost_info/

# Editor
.vscode/
*.swp

# Claude Code / citation-checker local state (not part of the repo)
.claude/
.citation-checker/
