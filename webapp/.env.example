# Copy this file to webapp/.env and fill in real values. webapp/.env is gitignored --
# never commit real values. See ARCHITECTURE.md #9 for why secrets never appear in code.

# Only needed if an HF Hub download ever requires authentication (public repos don't).
HF_TOKEN=

# "production" disables FastAPI's /docs and /redoc and enables the sanitized global
# error handler. Leave unset (or "development") for local work.
ENV=development

# Repo id on the Hub that model_registry.py downloads rank1 artifacts from.
HF_MODEL_REPO=raghvendramall/pearl-benchmark-models
